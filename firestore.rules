rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /routines/{routineId} {
      allow read, write: if true;
    }
    match /logs/{logId} {
      allow read, write: if true;
    }
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /settings/{userId} {
      allow read, write: if true;
    }
    match /stats/{userId} {
      allow read, write: if true;
    }
    match /noro_context/{docId} {
      allow read, write: if true;
    }
  }
}
